# PostgreSQL — збігається з docker-compose.yml
DATABASE_URL="postgresql://app:app@localhost:5432/app?schema=public"

# Секрет для підпису JWT (у продакшені — довгий випадковий рядок!)
JWT_SECRET="super-secret-change-me-in-production"
JWT_EXPIRES_IN="1d"

# Порт бекенду
PORT=3000

# Дозволений origin фронтенду для CORS
CORS_ORIGIN="http://localhost:5173"
